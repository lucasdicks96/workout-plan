{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "../",
    "jsx": "react",
    "typeRoots": ["./node_modules/@types", "./src/types/express/"]
  },
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules"]
}
